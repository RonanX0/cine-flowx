{
  "name": "cineclip",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node tools/build-static.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run nuvem:test && node tools/test-nvidia-proxy.mjs && node tools/test-ig-publish.mjs",
    "ig:test": "node tools/test-ig-publish.mjs",
    "nuvem": "node tools/dev-server.mjs",
    "nuvem:presign": "PORT=4174 MOCK_MAX_DIRECT_MB=1 node tools/dev-server.mjs",
    "nuvem:test": "node tools/test-cinecloud.mjs",
    "patch:extrair": "node tools/extract-patch-targets.mjs",
    "patch:nuvem": "node tools/apply-cloud-patch.mjs --verify",
    "patch:agendador": "node tools/build-agendador-patch.mjs && node tools/apply-cloud-patch.mjs --verify",
    "patch:base": "node tools/restore-base.mjs",
    "patch:full": "node tools/restore-base.mjs && node tools/extract-patch-targets.mjs && node tools/apply-cloud-patch.mjs --verify"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@ffmpeg/util": "^0.12.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@tailwindcss/vite": "^4.0.9",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "mediainfo.js": "0.3.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
