/* ==CINECLIP-FFMPEG-CDN== o motor de vídeo (~30 MB) vem do unpkg; se o unpkg falhar ou
   ficar parado, tenta o jsDelivr — antes o lote ficava preso em "A processar o vídeo… 0%". */
async function _ccCdn(r){const urls=[r];/^https:\/\/unpkg\.com\//.test(r)&&(window.__ccCdnRuim?urls.unshift(r.replace("https://unpkg.com/","https://cdn.jsdelivr.net/npm/")):urls.push(r.replace("https://unpkg.com/","https://cdn.jsdelivr.net/npm/")));let ult=null;for(const u of urls){const ac=typeof AbortController!="undefined"?new AbortController:null;let tm=null;const parar=()=>{try{ac&&ac.abort()}catch(e){}};try{tm=setTimeout(parar,45e3);const res=await fetch(u,ac?{signal:ac.signal}:void 0);if(!res.ok)throw new Error("HTTP "+res.status);if(!res.body||!res.body.getReader){clearTimeout(tm);tm=setTimeout(parar,240e3);const b=await res.arrayBuffer();clearTimeout(tm);return b}const rd=res.body.getReader(),partes=[];let n=0;for(;;){clearTimeout(tm);tm=setTimeout(parar,30e3);const{done,value}=await rd.read();if(done)break;partes.push(value);n+=value.length}clearTimeout(tm);const out=new Uint8Array(n);let o=0;for(const p of partes){out.set(p,o);o+=p.length}return out.buffer}catch(e){clearTimeout(tm);ult=e;/unpkg\.com/.test(u)&&(window.__ccCdnRuim=1)}}throw new Error("Não consegui baixar o motor de vídeo (FFmpeg) — verifica a internet e tenta de novo. ("+((ult&&ult.message)||ult)+")")}async function Ag(){
