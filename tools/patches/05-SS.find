async function SS(r){const o=await fetch(`${jg}/GetValue/${Cg}/cc_${r.vaultHash}?t=${Date.now()}`,{cache:"no-store"});if(!o.ok)return null;const a=(await o.text()).replace(/^"|"$/g,"").trim();if(!a)return null;const i=a.split("__");for(const c of i)try{if(c.startsWith("b_")){const u=c.slice(2),f=await fetch(`https://bytebin.lucko.me/${u}?t=${Date.now()}`,{cache:"no-store"});if(f.ok){const p=await f.text();return await Gm(p,r.encryptionKeyB64)}}else if(c.startsWith("k_")){const u=c.slice(2),f=await fetch(`https://kappa.lol/${u}.json?t=${Date.now()}`,{cache:"no-store"});if(f.ok){const p=await f.text();return await Gm(p,r.encryptionKeyB64)}}}catch{}return null}