Se(Be),vS({title:Pe.title,year:Pe.year,caption:Be,date:Date.now()});const _ccInfo=_ccLegendaIncompleta(Be),_ccFoiCortada=_ccLerCorte();_ccInfo.incompleta?je.warning(_ccFoiCortada?"A IA ficou sem limite de tokens e a legenda chegou cortada ("+_ccInfo.palavras+" palavras, "+_ccInfo.blocos+" parágrafos). Clica em \"Outra versão\" para a escreveres completa.":"A legenda chegou incompleta ("+_ccInfo.palavras+" palavras, "+_ccInfo.blocos+" parágrafos). Clica em \"Outra versão\" para a reescrever."):je.success("Legenda gerada!")