function Eh(r,o,a,i=720){const c=Math.max(2,r-r%2),u=Math.max(2,o-o%2),f=Math.round(i*16/9),p=a?Math.max(0,a.top):0,g=a?Math.max(0,a.bottom):0,v=Math.min(u-2,Math.max(0,Math.round(p/2)*2)),x=Math.max(0,Math.round(g/2)*2),h=Math.max(2,Math.min(u-v,Math.floor((u-v-x)/2)*2)),w=c,_=v>0||x>0;const aspect=w/h;let S=i,T=f,D=0,k=0;if(aspect<=0.65){S=i;T=f;D=0;k=0}else{S=i;T=Math.max(2,Math.round((i*h/w)/2)*2);if(T>f){T=f;S=Math.max(2,Math.floor((f*w/h)/2)*2);D=Math.max(0,Math.floor((i-S)/4)*2)}k=Math.max(0,Math.round((f-T)*0.46/2)*2)}return{outWidth:i,outHeight:f,vw:c,vh:u,hasCrop:_,cropX:0,cropY:v,cropW:w,cropH:h,videoW:S,videoH:T,padX:D,padY:k}}
