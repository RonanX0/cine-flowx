d.jsxs("div",{className:"space-y-3 rounded-lg border border-border p-3",children:[d.jsx("p",{className:"text-xs text-muted-foreground",children:"Reserva grátis se o Gemini falhar ou acabar a cota. Ordem: Gemini → Groq (+ busca) → OpenRouter."}),d.jsx(_c,{id:"groq",label:"Chave da API Groq (visão + áudio)",badge:"Grátis",help:"Obter em console.groq.com/keys",helpUrl:"https://console.groq.com/keys",placeholder:"gsk_...",value:c.groqKey||"",onChange:f=>u({...c,groqKey:f}),test:Qb}),d.jsx(_c,{id:"openrouter",label:"Chave da API OpenRouter (modelos :free)",help:"Obter em openrouter.ai/keys — limite de ~50 usos por dia nos modelos grátis",helpUrl:"https://openrouter.ai/keys",placeholder:"sk-or-...",value:c.openrouterKey||"",onChange:f=>u({...c,openrouterKey:f}),test:_ccTesteOR}),d.jsx(_c,{id:"serper",label:"Chave da API Serper (busca no Google, opcional)",help:"Obter em serper.dev — sem ela a busca usa o DuckDuckGo",helpUrl:"https://serper.dev",placeholder:"cola aqui a chave do Serper",value:c.serperKey||"",onChange:f=>u({...c,serperKey:f}),test:_ccTesteSerper}),d.jsxs("label",{className:"flex items-start gap-2 text-sm",children:[d.jsx("input",{type:"checkbox",id:"geminiBuscaForte",className:"mt-1",checked:c.geminiBuscaForte!==false,onChange:f=>u({...c,geminiBuscaForte:f.target.checked})}),d.jsx("span",{children:"Usar o Gemini 2.5 Pro na busca do título (mais certeiro, mas gasta mais cota grátis). Desmarque para usar só o Flash."})]})]}),d.jsxs("div",{className:"space-y-1.5",children:[d.jsx(er,{htmlFor:"ganchosBons",children:"Ganchos que você gosta (um por linha) — a IA imita o estilo"}),d.jsx("textarea",{id:"ganchosBons",rows:4,className:"flex w-full rounded-md border border-input bg-background px-3 py-2 text-sm",placeholder:"Ex.: O policial achou o corpo e descobriu que o assassino era ele 😳",value:c.ganchosBons||"",onChange:f=>u({...c,ganchosBons:f.target.value})})]}),d.jsxs("div",{className:"space-y-1.5",children:[d.jsx(er,{htmlFor:"ganchosRuins",children:"Ganchos que