/* ==CINECLIP-DESFOQUE== Fundo desfocado (o vídeo ampliado e borrado por trás, comum nos cortes do TikTok): uma linha lisa em TODOS os quadros e não escura não é filme. _wNit mede a nitidez de cada linha; _wDesfoque fica com o maior trecho nítido dentro das faixas já achadas (mesma regra de servidor/video.mjs). */function _wNit(o,a,i){const{data:c}=o.getImageData(0,0,a,i),n=new Float32Array(i),l=new Float32Array(i);for(let y=0;y<i;y++){let s=0,m=0,q=-1;for(let x=0;x<a;x++){const k=(y*a+x)*4,L=.299*c[k]+.587*c[k+1]+.114*c[k+2];q>=0&&(s+=Math.abs(L-q)),q=L,m+=L}n[y]=s/Math.max(1,a-1),l[y]=m/a}return{n,l}}function _wDesfoque(S,T,n,l,v){const d=y=>n[y]<1.5&&l[y]>=40,f=Math.max(2,Math.round(v*.01));let b=null,p=-1,e=-1,u=0;for(let y=S;y<=T+1;y++)if(y<=T&&!d(y))p<0&&(p=y),e=y,u=0;else if(p>=0&&(u++,u>f||y>T)){(!b||e-p>b[1]-b[0])&&(b=[p,e]),p=-1,u=0}if(!b||b[1]-b[0]+1<v*.3)return[S,T];const m=v*.03;return[b[0]-S>=m?b[0]:S,T-b[1]>=m?b[1]:T]}function _w(r,o,a,i){o.drawImage(r,0,0,a,i);
