/* ==CINECLIP-POR-NOME== identificar DIRETO pelo nome (dica digitada ou nome do ficheiro), sem a IA de vídeo: procura no TMDB e só aceita se o título bater mesmo */async function cineclipPorNome(r,i){const o=i||{};if(!r)return null;const cand=[],dica=String(o.userHint||"").trim();dica&&cand.push({texto:dica,forte:!0});const ff=fg(o.fileName,o.metaTitle);if(ff)for(const t of ff.split(" / "))cand.push({texto:t,forte:!1});const vistos=new Set;for(const c of cand){const anoM=c.texto.match(/\b(19\d\d|20\d\d)\b/),ano=anoM?Number(anoM[1]):0,nome=c.texto.replace(/\b(19\d\d|20\d\d)\b/g," ").replace(/#\S+/g," ").replace(/[()\[\]]/g," ").replace(/\b(dublado|legendado|cena|clipe|trailer|4k|1080p|720p|hd)\b/gi," ").replace(/\s+/g," ").trim(),q=fi(nome);if(q.length<3||vistos.has(q))continue;vistos.add(q);if(!c.forte&&!(ano||q.split(" ").length>=2||q.length>=6))continue;let lista=[];try{lista=await Ru(r,nome)}catch{continue}const bate=lista.filter(S=>{const a=fi(S.title||""),b=fi(S.original||"");if(ano&&S.year&&Math.abs(Number(S.year)-ano)>1)return!1;if(a===q||b===q)return!0;if(!c.forte||q.length<5)return!1;for(const t of[a,b])if(t&&(t.includes(q)||q.includes(t))&&Math.min(t.length,q.length)/Math.max(t.length,q.length)>=.6)return!0;return!1});if(!bate.length)continue;const det=await pg(r,bate[0]);det.verificacao={porNome:!0,atores:0,atoresNoElenco:null,personagens:0,personagensNoElenco:null};det.porNome=nome;return det}return null}async function cineclipIdentificarEstudio(r,o,a,i,c){const f=await cineclipPorNome(c,i).catch(()=>null);return f?{titulo:f.title,titulo_original:f.original,ano:f.year,confianca:100,atores:[],personagens:[],alternativas:[],provedor:"nome",_filme:f}:Zb(r,o,a,i)}function fg(r,o){
