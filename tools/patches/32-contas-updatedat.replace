te=(F,ue)=>{/* ==CINECLIP-CONTAS-UPDATEDAT== só as contas que mudaram ganham updatedAt novo: trocar de conta já não "rejuvenesce" uma cópia antiga, que na sincronização apagaria horários editados noutro aparelho */const ccAgora=Date.now(),Be=F.map(Ue=>{const ccAnt=c.find(ccA=>ccA.id===Ue.id);return ccAnt&&JSON.stringify({...ccAnt,updatedAt:0})===JSON.stringify({...Ue,updatedAt:0})?Ue:{...Ue,updatedAt:Math.max(ccAgora,Number(Ue.updatedAt)||0)}});