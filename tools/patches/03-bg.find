async function bg(r,o){const i=`${(o||"reel_cineclip.mp4").replace(/[^a-zA-Z0-9._-]/g,"_").replace(/\.mp4$/i,"")}.mp4`;try{const c=new FormData;c.append("file",new Blob([r],{type:"video/mp4"}),i);const u=await fetch("https://kappa.lol/api/upload",{method:"POST",body:c});if(u.ok){const f=await u.json();if(f!=null&&f.link){const p=f.ext||".mp4";return String(f.link).endsWith(p)?String(f.link):`${f.link}${p}`}}}catch{}try{const c=await fetch("/api/public/upload-temp",{method:"POST",headers:{"Content-Type":"video/mp4","X-File-Name":i},body:r});if(c.ok){const u=await c.json();if(u!=null&&u.url&&String(u.url).startsWith("http"))return String(u.url)}}catch{}throw new Error("Não foi possível gerar link direto (.mp4) do vídeo para o Instagram.")}