{"analise": {"momento": "...", "emocao": "...", "gatilho": "...", "visual": "..."}, "cena": "o que acontece na cena", "ganchos": [{"texto": "...", "nota": 8}, {"texto": "...", "nota": 6}, {"texto": "...", "nota": 7}, {"texto": "...", "nota": 5}, {"texto": "...", "nota": 9}, {"texto": "...", "nota": 6}]}`;
