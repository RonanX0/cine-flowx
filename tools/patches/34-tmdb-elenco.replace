async function nS(r,o){/* ==CINECLIP-TMDB-ELENCO== escolhe o filme no TMDB e CONFERE com o elenco: os atores reconhecidos e os nomes de personagens ouvidos/lidos têm de estar no elenco do candidato. Antes, um filme popular do mesmo ator podia ganhar ao filme certo. */const anoIA=o.ano?Number(String(o.ano).slice(0,4)):0;const titulos=[...new Set([o.titulo_original,o.titulo,...((o.alternativas||[]).slice(0,3).map(S=>S&&(S.titulo_original||S.titulo)))].map(S=>S?String(S).trim():"").filter(Boolean))];const limparNome=S=>fi(String(S||"").replace(/\([^)]*\)/g,"").replace(/\bcomo\s+.*/i,"").replace(/\bas\s+.*/i,""));const atores=[...new Set((o.atores||[]).map(limparNome).filter(S=>S.length>=4))].slice(0,6);const personagens=[...new Set((o.personagens||[]).map(S=>fi(S)).filter(S=>S.length>=3&&!/^(ele|ela|homem|mulher|pai|mae|policial|detetive|doutor|dr|senhor|senhora)$/.test(S)))].slice(0,6);const [buscas,doAtor]=await Promise.all([Promise.all(titulos.map(S=>Ru(r,S).catch(()=>[]))),o.atores&&o.atores.length?mg(r,o.atores).catch(()=>[]):Promise.resolve([])]);const doAtorIds=new Set(doAtor.map(S=>`${S.kind}-${S.id}`));const mapa=new Map;for(const lista of buscas)for(const S of lista){const k=`${S.kind}-${S.id}`;mapa.has(k)||mapa.set(k,S)}for(const S of doAtor){const k=`${S.kind}-${S.id}`;mapa.has(k)||mapa.set(k,S)}const todos=[...mapa.values()];if(!todos.length)return null;const tOrig=fi(o.titulo_original||""),tPt=fi(o.titulo||"");const pontos=S=>{let T=0;const D=fi(S.original),O=fi(S.title);if(tOrig&&(D===tOrig||O===tOrig))T+=65;else if(tPt&&(O===tPt||D===tPt))T+=60;else if(tOrig&&D&&(D.includes(tOrig)||tOrig.includes(D))||tPt&&O&&(O.includes(tPt)||tPt.includes(O)))T+=32;/* filme do mesmo ator: só desempata (o elenco é conferido a seguir) */if(doAtorIds.has(`${S.kind}-${S.id}`))T+=25;if(o.tipo&&S.kind===o.tipo)T+=12;const ano=Number(S.year)||0;if(anoIA&&ano){const V=Math.abs(anoIA-ano);V===0?T+=22:V<=1?T+=16:V<=2?T+=10:S.kind==="tv"&&anoIA>=ano&&anoIA-ano<=12?T+=12:V>=8&&(T-=10)}return T+Math.min(20,Math.log10((S.popularity||1)+1)*10)};for(const S of todos)S._pont=pontos(S);todos.sort((S,T)=>T._pont-S._pont);const topo=todos.slice(0,6);if(atores.length||personagens.length){const creditos=await Promise.all(topo.map(S=>vo(r,`/${S.kind}/${S.id}/${S.kind==="tv"?"aggregate_credits":"credits"}`,{language:"pt-BR"}).catch(()=>null)));topo.forEach((S,n)=>{const elenco=((creditos[n]&&creditos[n].cast)||[]).slice(0,60);if(!elenco.length){S._elenco=null;S._personagens=null;return}const nomes=elenco.map(c=>fi(c.name||c.original_name||""));const papeis=[];for(const c of elenco){if(c.character)papeis.push(fi(c.character));for(const x of c.roles||[])x&&x.character&&papeis.push(fi(x.character))}let a=0;for(const at of atores)nomes.some(nm=>nm&&(nm===at||nm.length>=6&&at.length>=6&&(nm.includes(at)||at.includes(nm))))&&a++;let pc=0;for(const pe of personagens){const primeiro=pe.split(" ")[0];papeis.some(pa=>pa&&(pa===pe||pa.includes(pe)||primeiro.length>=4&&pa.split(/[\s\/]+/).includes(primeiro)))&&pc++}S._elenco=a;S._personagens=pc;S._pont+=Math.min(2,a)*45+Math.min(2,pc)*35});topo.sort((S,T)=>T._pont-S._pont)}const melhor=topo[0];if(!melhor)return null;const det=await pg(r,melhor);det.verificacao={atores:atores.length,atoresNoElenco:melhor._elenco==null?null:melhor._elenco,personagens:personagens.length,personagensNoElenco:melhor._personagens==null?null:melhor._personagens};return det}