/* ==CINECLIP-COMPRIMIR== Deixa um vídeo abaixo de ~88 MB sem o editar (para o Agendamento rápido, que envia o original): reconverte com o mesmo teto de bitrate pela duração do YS (patch zz-25). O Worker R2 grátis recusa envios acima de 100 MB. */async function _ccComprimir(r,u){let g=0;try{const m=await WS(r);g=m&&m.duration||0}catch{}if(!g)try{const m=await Mg(r);g=Number(m&&m.duration)||0}catch{}g=g||60;const t=Math.max(1500,Math.min(12e3,Math.floor((704e6/Math.max(1,g)-128e3)/1e3)));return _ccComLock(async()=>{const jid=++_ccJob,p=`cin_${jid}.${HS(r.name||"video.mp4")}`,out=`cout_${jid}.mp4`,b=await VS(["-i",p,"-map","0:v:0","-map","0:a:0?","-map_metadata","-1","-c:v","libx264","-profile:v","main","-crf","24","-maxrate",t+"k","-bufsize",2*t+"k","-preset","ultrafast","-pix_fmt","yuv420p","-c:a","aac","-ar","44100","-ac","2","-b:a","128k","-movflags","+faststart",out],p,r,out,g,u||(()=>{}));return new File([b],String(r.name||"video").replace(/.[^.]+$/,"")+".mp4",{type:"video/mp4"})})}function XS(r,o,a,i,c){
