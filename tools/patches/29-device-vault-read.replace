async function SS(r){const restore=v=>{if(v&&Array.isArray(v.queue))v.queue=v.queue.map(q=>({...q,status:q.status==="device_scheduled"?"scheduled":q.status}));return v};if(window.CineCloud){const ne=await window.CineCloud.getVaultCipher(r.vaultHash);if(window.CineCloud.markReadFailure(!!ne.readFailed),!ne.data)return null;try{return restore(await Gm(ne.data,r.encryptionKeyB64))}catch(ie){return window.CineCloud.log("error","Cofre encontrado mas não foi possível desencriptar — o usuário/senha usados agora são diferentes dos usados na criação do cofre? "+ie.message),null}}const o=await fetch(`${jg}/GetValue/${Cg}/cc_${r.vaultHash}?t=${Date.now()}`,{cache:"no-store"});if(!o.ok)return null;const a=(await o.text()).replace(/^"|"$/g,"").trim();if(!a)return null;const i=a.split("__");for(const c of i)try{if(c.startsWith("b_")){const u=c.slice(2),f=await fetch(`https://bytebin.lucko.me/${u}?t=${Date.now()}`,{cache:"no-store"});if(f.ok){const p=await f.text();return restore(await Gm(p,r.encryptionKeyB64))}}else if(c.startsWith("k_")){const u=c.slice(2),f=await fetch(`https://kappa.lol/${u}.json?t=${Date.now()}`,{cache:"no-store"});if(f.ok){const p=await f.text();return restore(await Gm(p,r.encryptionKeyB64))}}}catch{}return null}
