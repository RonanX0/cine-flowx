/* ==CINECLIP-PRESETS-REEL== Formatos de Reel prontos, medidos pixel a pixel em capturas reais: "escuro" = fundo preto, gancho fluorescente, caixa 1:1 arredondada com margens e rodapé verde; "claro" = fundo branco, gancho preto e faixa 4:3 de ponta a ponta. Todas as medidas são frações da largura/altura do 9:16 final. */const PRESETS_DO_REEL={atual:{id:"atual",nome:"Padrão do app",caixa:"auto",margem:0,raio:0,topo:.46,fundo:"preto",bgMode:"preto",ganchoPill:!0,ganchoTamanho:.062,ganchoEntrelinha:1.28,ganchoCor:"#FFFFFF",rodapeTamanho:0,rodapeY:0,rodapeCor:"#2DBD2C"},escuro:{id:"escuro",nome:"Escuro · caixa 1:1",caixa:"quadrado",margem:.05,raio:.046,topo:.274,fundo:"preto",bgMode:"preto",ganchoPill:!1,ganchoTamanho:.072,ganchoEntrelinha:.88,ganchoCor:"#ECFA12",rodapeTamanho:.049,rodapeY:.9355,rodapeCor:"#2DBD2C"},claro:{id:"claro",nome:"Claro · faixa 4:3",caixa:"banda",margem:0,raio:0,topo:.301,fundo:"branco",bgMode:"branco",ganchoPill:!1,ganchoTamanho:.056,ganchoEntrelinha:1.35,ganchoCor:"#000000",rodapeTamanho:0,rodapeY:0,rodapeCor:"#2DBD2C"},perfil:{"id":"perfil","nome":"Claro · faixa preta no fim","caixa":"livre","margem":0,"raio":0,"topo":0.301,"caixaFim":0.84,"fundo":"branco","bgMode":"branco","ganchoPill":false,"ganchoTamanho":0.062,"ganchoEntrelinha":1.25,"ganchoCor":"#000000","rodapeTamanho":0.033,"rodapeY":0.884,"rodapeCor":"#FFFFFF","rodapeFaixa":true,"rodapeFundo":"#000000","rodapeFixo":"Link do filme completo na minha B10","rodapeNota":"Nome do filme na legenda 🔽","rodapeNotaTamanho":0.029,"rodapeNotaY":0.938,"rodapeNotaCor":"#000000"},destaque:{"id":"destaque","nome":"Claro · gancho vermelho","caixa":"livre","margem":0,"raio":0,"topo":0.281,"caixaFim":0.84,"fundo":"branco","bgMode":"branco","ganchoPill":false,"ganchoTamanho":0.052,"ganchoEntrelinha":1.22,"ganchoCor":"#EC1C24","rodapeTamanho":0.033,"rodapeY":0.884,"rodapeCor":"#FFFFFF","rodapeFaixa":true,"rodapeFundo":"#000000","rodapeFixo":"Link do filme completo na minha B10","rodapeNota":"Nome do filme na legenda 🔽","rodapeNotaTamanho":0.029,"rodapeNotaY":0.938,"rodapeNotaCor":"#000000"}};function presetDoReel(r){return PRESETS_DO_REEL[r]||PRESETS_DO_REEL.atual}function alvoDaCaixa(r){return r.caixa==="quadrado"?1:r.caixa==="banda"?4/3:0}function caixaDoPreset(r,o,a,i){const c=presetDoReel(r);return{padX:o.padX,padY:o.padY,videoW:o.videoW,videoH:o.videoH,radius:o.radius||0,fundo:c.fundo,rodape:a||"",rodapeCor:i||c.rodapeCor}}function Eh(r,o,a,i=720,preset="atual"){const c=Math.max(2,r-r%2),u=Math.max(2,o-o%2),f=Math.round(i*16/9),p=a?Math.max(0,a.top):0,g=a?Math.max(0,a.bottom):0,v=Math.min(u-2,Math.max(0,Math.round(p/2)*2)),x=Math.max(0,Math.round(g/2)*2),h=Math.max(2,Math.min(u-v,Math.floor((u-v-x)/2)*2)),w=c,_=v>0||x>0;const P=presetDoReel(preset),A=alvoDaCaixa(P);if(P.caixa==="livre"){const ty=Math.max(0,Math.round(f*P.topo/2)*2),fy=Math.min(f,Math.round(f*(P.caixaFim||.95)/2)*2),dh=Math.max(2,fy-ty);const S=Math.max(2,Math.round(i*(1-2*P.margem)/2)*2);let T=Math.max(2,Math.round(S*h/w/2)*2),cy=v,cw=w,ch=h;if(T>dh){T=Math.max(2,Math.round(dh/2)*2);const nh=Math.max(2,Math.min(ch,Math.round(cw*T/S/2)*2));cy+=Math.max(0,Math.round((ch-nh)/2/2)*2);ch=nh}const D=Math.max(0,Math.round((i-S)/2/2)*2),k=Math.max(0,Math.min(f-T,ty+Math.round((dh-T)/2/2)*2));return{outWidth:i,outHeight:f,vw:c,vh:u,hasCrop:cy>0||ch<u||cw<c,cropX:0,cropY:cy,cropW:cw,cropH:ch,videoW:S,videoH:T,padX:D,padY:k,radius:Math.max(0,Math.round(S*P.raio)),bg:P.fundo,preset:P.id}}if(A>0){let S=Math.max(2,Math.round(i*(1-2*P.margem)/2)*2),T=Math.max(2,Math.round(S/A/2)*2);if(T>f-2){T=Math.max(2,Math.round((f-2)/2)*2);S=Math.min(i,Math.max(2,Math.round(T*A/2)*2))}const D=Math.max(0,Math.round((i-S)/2/2)*2),k=Math.max(0,Math.min(f-T-2,Math.round(f*P.topo/2)*2));let cw=w,ch=h,cx=0,cy=v;const fa=cw/ch;if(fa>A){const nw=Math.max(2,Math.min(cw,Math.round(ch*A/2)*2));cx+=Math.max(0,Math.round((cw-nw)/2/2)*2);cw=nw}else if(fa<A){const nh=Math.max(2,Math.min(ch,Math.round(cw/A/2)*2));cy+=Math.max(0,Math.round((ch-nh)/2/2)*2);ch=nh}return{outWidth:i,outHeight:f,vw:c,vh:u,hasCrop:cx>0||cy>0||cw<c||ch<u,cropX:cx,cropY:cy,cropW:cw,cropH:ch,videoW:S,videoH:T,padX:D,padY:k,radius:Math.max(0,Math.round(S*P.raio)),bg:P.fundo,preset:P.id}}const aspect=w/h;let S=i,T=f,D=0,k=0;if(aspect<=0.65){S=i;T=f;D=0;k=0}else{S=i;T=Math.max(2,Math.round((i*h/w)/2)*2);if(T>f){T=f;S=Math.max(2,Math.floor((f*w/h)/2)*2);D=Math.max(0,Math.floor((i-S)/4)*2)}k=Math.max(0,Math.round((f-T)*0.46/2)*2)}return{outWidth:i,outHeight:f,vw:c,vh:u,hasCrop:_,cropX:0,cropY:v,cropW:w,cropH:h,videoW:S,videoH:T,padX:D,padY:k,radius:0,bg:P.fundo,preset:P.id}}
