{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ],
  "functions": {
    "api/public/importar.js": {
      "maxDuration": 60
    },
    "api/public/ia.js": {
      "maxDuration": 60
    },
    "api/public/tendencias.js": {
      "maxDuration": 120
    },
    "api/nuvem.js": {
      "maxDuration": 300,
      "includeFiles": "{index.html,nuvem-duravel.js,motor-ia.js,lote-massa.js,servidor/fontes/**,node_modules/ffmpeg-static/ffmpeg,node_modules/@napi-rs/canvas-linux-x64-gnu/**}"
    }
  },
  "fluid": true
}
